// ✏️ Change the slogan here. It's used for the headline only (it may contain HTML, so keep it out of the description).
replace SLOGAN Launchation.<br>A new kind of event for<br>a new kind of book.<br>Turtle Bay.

title Launchation · Knowbooks.com Launch Event · Nov 4–6, Oahu
description If you're not into smartphones, come to Turtle Bay and escape. Knowbooks.com Launch Event, November 4–6, 2026, Oahu, Hawaii.
baseUrl https://launchation.com/
permalink index.html
openGraphImage og.png
favicon favicon.svg
htmlLang en
buildHtml
metaTags

<video id="bg" class="bg" autoplay muted playsinline></video>
<div id="transport" class="transport" role="group" aria-label="Video controls">
 <button id="play" class="t-btn" type="button" aria-label="Play">▶</button>
 <span id="cur" class="t-time">0:00</span>
 <input id="seek" class="t-seek" type="range" min="0" max="1000" value="0" step="1" aria-label="Seek">
 <span id="dur" class="t-time">0:00</span>
 <button id="sound" class="t-btn" type="button" aria-pressed="true">🔇</button>
</div>

main
