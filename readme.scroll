script
 const v = bg, b = sound
 const unmute = () => { v.muted = false; v.play(); b.hidden = true }
 v.play().catch(() => { v.muted = true; v.play(); b.hidden = false; document.addEventListener("pointerdown", unmute, { once: true }) })

css
 .sound { position: fixed; right: 20px; bottom: 20px; font: 600 13px/1 ui-sans-serif, system-ui, sans-serif; letter-spacing: .08em; color: #fff8ec; padding: 12px 18px; border-radius: 999px; border: 1px solid rgba(255,210,122,.6); background: rgba(11,20,36,.45); backdrop-filter: blur(8px); cursor: pointer; }
 .sound[hidden] { display: none; }
 * { box-sizing: border-box; }
 html { background: #0b1424; } body { margin: 0; min-height: 100%; color: #fff8ec; }
 body { font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif; }
 .bg { position: fixed; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
 body::before { content: ""; position: fixed; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(8,14,30,.55), rgba(8,14,30,.25) 40%, rgba(30,10,40,.85)), radial-gradient(ellipse at 50% 60%, transparent, rgba(0,0,0,.5)); }
 html, body { height: 100%; overflow: hidden; }
 main { height: 100vh; height: 100dvh; max-width: 1000px; margin: auto; padding: 3dvh 6vw; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; overflow: hidden; }
 .kicker { font: 600 clamp(10px, 1.6dvh, 13px)/1 ui-sans-serif, system-ui, sans-serif; letter-spacing: .35em; text-transform: uppercase; color: #ffd27a; margin: 0 0 2.5dvh; }
 h1 { font-weight: 400; font-style: italic; font-size: clamp(22px, min(7vw, 6.3dvh), 76px); line-height: 1.08; margin: 0; text-shadow: 0 4px 40px rgba(0,0,0,.5); text-wrap: balance; }
 .dates { font: 700 clamp(12px, min(1.8vw, 2.2dvh), 20px)/1.4 ui-sans-serif, system-ui, sans-serif; letter-spacing: .14em; text-transform: uppercase; margin: 3dvh 0 0; padding: 1.2dvh 22px; border-top: 1px solid rgba(255,210,122,.6); border-bottom: 1px solid rgba(255,210,122,.6); }
 .sub { font-size: clamp(15px, min(2vw, 2.6dvh), 22px); opacity: .9; margin: 1.8dvh 0 3dvh; }
 .ctas { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; }
 .cta, .ghost { font: 600 clamp(14px, 2dvh, 16px)/1 ui-sans-serif, system-ui, sans-serif; color: #fff8ec; text-decoration: none; padding: clamp(11px, 2dvh, 17px) 26px; border-radius: 999px; border: 1px solid rgba(255,248,236,.55); backdrop-filter: blur(8px); background: rgba(255,255,255,.08); transition: transform .2s, background .2s; }
 .cta:hover, .ghost:hover { transform: translateY(-2px); } .ghost:hover { background: rgba(255,255,255,.18); }
 .cta { background: linear-gradient(135deg, #ffb35c, #ff6f61); border-color: transparent; color: #1b0f1f; box-shadow: 0 10px 30px rgba(255,111,97,.35); }
 .note { font: clamp(12px, 1.7dvh, 14px)/1.45 ui-sans-serif, system-ui, sans-serif; opacity: .75; margin: 2.5dvh 0 0; max-width: 34em; }
 .note a { color: #ffd27a; }
 .home { font: 600 12px/1 ui-sans-serif, system-ui, sans-serif; letter-spacing: .25em; text-transform: uppercase; color: #ffd27a; text-decoration: none; margin-top: 3dvh; }
 @media (prefers-reduced-motion: reduce) { .bg { display: none; } html { background: #0b1424 url(poster.jpg) center/cover fixed; } .cta, .ghost { transition: none; } }
