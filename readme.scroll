script
 const clips = ["why.mp4", "koa.mp4", "launchation12days.mp4", "launchationBrunch.mp4", "tenDays.mp4", "thereWillBeGolf.mp4"]
 let i = 0, scrubbing = false
 const v = bg, b = sound, btn = play, bar = seek
 const fmt = (s) => { s = Math.max(0, s|0); return ((s/60)|0) + ":" + String(s%60).padStart(2,"0") }
 const syncMute = () => { b.textContent = v.muted ? "🔇" : "🔈"; b.setAttribute("aria-pressed", String(v.muted)); b.title = v.muted ? "Unmute" : "Mute" }
 const syncPlay = () => { btn.textContent = v.paused ? "▶" : "❚❚"; btn.setAttribute("aria-label", v.paused ? "Play" : "Pause") }
 const syncSeek = () => {
  if (scrubbing || !v.duration) return
  bar.max = 1000
  bar.value = Math.round((v.currentTime / v.duration) * 1000)
  cur.textContent = fmt(v.currentTime)
  dur.textContent = fmt(v.duration)
 }
 const playClip = () => { v.src = clips[i % clips.length]; v.play().catch(() => { v.muted = true; syncMute(); v.play().catch(() => {}) }).finally(syncPlay) }
 v.addEventListener("ended", () => { i = (i + 1) % clips.length; playClip() })
 v.addEventListener("timeupdate", syncSeek)
 v.addEventListener("loadedmetadata", syncSeek)
 v.addEventListener("play", syncPlay)
 v.addEventListener("pause", syncPlay)
 btn.addEventListener("click", () => { if (v.paused) v.play().catch(() => {}); else v.pause() })
 b.addEventListener("click", () => { v.muted = !v.muted; if (!v.muted) v.play().catch(() => {}); syncMute() })
 bar.addEventListener("pointerdown", () => { scrubbing = true })
 bar.addEventListener("pointerup", () => { scrubbing = false })
 bar.addEventListener("input", () => {
  if (!v.duration) return
  v.currentTime = (Number(bar.value) / 1000) * v.duration
  cur.textContent = fmt(v.currentTime)
 })
 document.querySelectorAll(".dvd").forEach((el) => el.addEventListener("click", (e) => {
  e.preventDefault()
  i = Number(el.dataset.i) || 0
  playClip()
 }))
 document.addEventListener("keydown", (e) => {
  if (e.target.closest("a,button,input,textarea")) return
  if (e.key === "ArrowLeft") { e.preventDefault(); v.currentTime = Math.max(0, v.currentTime - 10) }
  else if (e.key === "ArrowRight") { e.preventDefault(); v.currentTime = Math.min(v.duration || 0, v.currentTime + 10) }
  else if (e.key === "m" || e.key === "M") { v.muted = !v.muted; syncMute() }
  else if (e.key === " ") { e.preventDefault(); if (v.paused) v.play().catch(() => {}); else v.pause() }
  else if (e.key === "n" || e.key === "N") { i = (i + 1) % clips.length; playClip() }
  else if (e.key === "p" || e.key === "P") { i = (i - 1 + clips.length) % clips.length; playClip() }
 })
 v.muted = true
 syncMute(); syncPlay()
 playClip()

css
 .transport { position: fixed; left: 50%; bottom: 10px; transform: translateX(-50%); z-index: 3; width: min(720px, calc(100% - 24px)); display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-radius: 999px; border: 1px solid rgba(255,210,122,.4); background: rgba(11,20,36,.55); backdrop-filter: blur(10px); box-sizing: border-box; }
 .t-btn { appearance: none; border: 0; background: transparent; color: #fff8ec; font: 600 14px/1 ui-sans-serif, system-ui, sans-serif; padding: 6px 8px; cursor: pointer; min-width: 2em; }
 .t-time { font: 600 11px/1 ui-sans-serif, system-ui, sans-serif; color: #ffd27a; min-width: 2.4em; tabular-nums: true; font-variant-numeric: tabular-nums; }
 .t-seek { flex: 1; accent-color: #ffb35c; height: 4px; cursor: pointer; }
 * { box-sizing: border-box; }
 html, body { height: 100%; margin: 0; overflow: hidden; background: #0b1424; color: #fff8ec; }
 body { font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif; }
 .bg { position: fixed; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; background: #0b1424; }
 body::before { content: ""; position: fixed; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(180deg, rgba(8,14,30,.45), rgba(8,14,30,.2) 45%, rgba(30,10,40,.72)), radial-gradient(ellipse at 50% 60%, transparent, rgba(0,0,0,.35)); }
 main { position: relative; z-index: 2; height: 100vh; height: 100dvh; max-width: 960px; margin: auto; padding: 2.2dvh 5vw 5.5dvh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; overflow: hidden; }
 .kicker { font: 600 clamp(9px, 1.4dvh, 12px)/1 ui-sans-serif, system-ui, sans-serif; letter-spacing: .32em; text-transform: uppercase; color: #ffd27a; margin: 0 0 1.4dvh; }
 h1 { font-weight: 400; font-style: italic; font-size: clamp(18px, min(5.8vw, 5.2dvh), 64px); line-height: 1.08; margin: 0; text-shadow: 0 4px 40px rgba(0,0,0,.5); text-wrap: balance; }
 .dates { font: 700 clamp(11px, min(1.6vw, 1.9dvh), 17px)/1.35 ui-sans-serif, system-ui, sans-serif; letter-spacing: .12em; text-transform: uppercase; margin: 1.8dvh 0 0; padding: .9dvh 18px; border-top: 1px solid rgba(255,210,122,.55); border-bottom: 1px solid rgba(255,210,122,.55); }
 .livestream { font: 600 clamp(11px, min(1.5vw, 1.8dvh), 15px)/1.3 ui-sans-serif, system-ui, sans-serif; letter-spacing: .1em; text-transform: uppercase; color: #ffd27a; margin: 1.2dvh 0 0; }
 .pillars { font: 600 clamp(9px, 1.3dvh, 11px)/1 ui-sans-serif, system-ui, sans-serif; letter-spacing: .28em; text-transform: uppercase; color: #ffd27a; margin: 1.1dvh 0 0; }
 .sub { font-size: clamp(13px, min(1.8vw, 2.1dvh), 18px); opacity: .9; margin: 1.1dvh 0 2dvh; }
 .cta { font: 600 clamp(13px, 1.9dvh, 16px)/1 ui-sans-serif, system-ui, sans-serif; color: #1b0f1f; text-decoration: none; padding: clamp(10px, 1.7dvh, 15px) 24px; border-radius: 999px; background: linear-gradient(135deg, #ffb35c, #ff6f61); box-shadow: 0 8px 24px rgba(255,111,97,.35); transition: transform .2s; }
 .cta:hover { transform: translateY(-2px); }
 .dvds-label { font: 600 clamp(10px, 1.4dvh, 12px)/1 ui-sans-serif, system-ui, sans-serif; letter-spacing: .22em; text-transform: uppercase; color: #ffd27a; margin: 2.4dvh 0 1.4dvh; opacity: .9; }
 .shelf { display: flex; flex-wrap: nowrap; gap: clamp(8px, 1.2vw, 14px); justify-content: center; max-width: 100%; }
 .dvd { flex: 0 0 auto; width: clamp(72px, 11vw, 108px); display: block; text-decoration: none; border-radius: 4px; overflow: hidden; border: 1px solid rgba(255,210,122,.35); box-shadow: 0 6px 16px rgba(0,0,0,.4); background: #120e0a; transition: transform .2s, border-color .2s; }
 .dvd img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
 .dvd:hover { transform: translateY(-3px); border-color: #ffd27a; }
 .note { font: clamp(11px, 1.5dvh, 13px)/1.4 ui-sans-serif, system-ui, sans-serif; opacity: .72; margin: 2dvh 0 0; max-width: 40em; }
 .note a { color: #ffd27a; }
 @media (max-width: 420px) { .dvd { width: clamp(56px, 14vw, 78px); } .shelf { gap: 6px; } }
 @media (prefers-reduced-motion: reduce) { .cta, .dvd { transition: none; } }

// DVD shelf — local posters/ + local mp4s. Click jumps background playlist.

// Background cycle (local only — no videos.knowbooks.com)
// Playlist: why, koa, launchation12days, launchationBrunch, tenDays, thereWillBeGolf
// DVD click → that clip; ended → next. Mute toggle always visible.
// Transport bar: play/pause, scrubber, mute. Keys: ←/→ ±10s, Space, M, N next, P previous.
